{
  "extraKnownMarketplaces": {
    "jorgecostamacia-agent-skills": {
      "source": { "source": "github", "repo": "JorgeCostaMacia/skills" }
    },
    "dotnet-agent-skills": {
      "source": { "source": "github", "repo": "dotnet/skills" }
    }
  },
  "enabledPlugins": {
    "ddd@jorgecostamacia-agent-skills": true,
    "ddd-net@jorgecostamacia-agent-skills": true,
    "validation-net@jorgecostamacia-agent-skills": true,
    "efcore-net@jorgecostamacia-agent-skills": true,
    "efcore-postgres-net@jorgecostamacia-agent-skills": true,
    "logging@jorgecostamacia-agent-skills": true,
    "logging-net@jorgecostamacia-agent-skills": true,
    "code-style-net@jorgecostamacia-agent-skills": true,
    "build-net@jorgecostamacia-agent-skills": true,
    "testing@jorgecostamacia-agent-skills": true,
    "testing-net@jorgecostamacia-agent-skills": true,
    "clean-architecture@jorgecostamacia-agent-skills": true,
    "solid@jorgecostamacia-agent-skills": true,
    "gitflow@jorgecostamacia-agent-skills": true,

    "dotnet@dotnet-agent-skills": true,
    "dotnet-msbuild@dotnet-agent-skills": true,
    "dotnet-nuget@dotnet-agent-skills": true,
    "dotnet-test@dotnet-agent-skills": true,
    "dotnet-test-migration@dotnet-agent-skills": true,
    "dotnet-upgrade@dotnet-agent-skills": true,
    "dotnet-data@dotnet-agent-skills": true
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(appsettings.json)",
      "Read(appsettings.*.json)",
      "Read(**/appsettings.json)",
      "Read(**/appsettings.*.json)",
      "Read(secrets.json)",
      "Read(**/secrets.json)",
      "Read(nuget.config)",
      "Read(**/nuget.config)",
      "Read(NuGet.Config)",
      "Read(**/NuGet.Config)",

      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.crt)",
      "Read(**/*.cer)",

      "Read(.pgpass)",
      "Read(**/.pgpass)",

      "Read(launchSettings.json)",
      "Read(**/launchSettings.json)",
      "Read(**/*.user)",

      "Read(**/*.bak)",
      "Read(**/*.dump)",

      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",

      "Bash(*appsettings*)",
      "Bash(*secrets.json*)",
      "Bash(*UserSecrets*)",
      "Bash(dotnet user-secrets*)",
      "Bash(*nuget.config*)",
      "Bash(*NuGet.Config*)",
      "Bash(*launchSettings*)",
      "Bash(*.pgpass*)",
      "Bash(*/.env*)",
      "Bash(* .env*)",
      "Bash(*.pfx*)",
      "Bash(*.p12*)",
      "Bash(*.pem*)",
      "Bash(*.key)",
      "Bash(*.key *)",
      "Bash(*.git-credentials*)",
      "Bash(*.netrc*)",
      "Bash(*.docker/config.json*)",
      "Bash(*.ssh/*)",
      "Bash(*.aws/*)",
      "Bash(*.kube/config*)",

      "Bash(cat *.env*)",
      "Bash(cat *appsettings*)",
      "Bash(cat *secrets.json*)",
      "Bash(cat *.pgpass*)",
      "Bash(type *.env*)",
      "Bash(type *appsettings*)",
      "Bash(Get-Content *.env*)",
      "Bash(Get-Content *appsettings*)",

      "Bash(git push)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)"
    ]
  }
}
