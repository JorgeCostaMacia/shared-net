{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(appsettings.json)",
      "Read(appsettings.*.json)",
      "Read(**/appsettings.json)",
      "Read(**/appsettings.*.json)",
      "Read(secrets.json)",
      "Read(**/secrets.json)",
      "Read(nuget.config)",
      "Read(**/nuget.config)",
      "Read(NuGet.Config)",
      "Read(**/NuGet.Config)",

      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.crt)",
      "Read(**/*.cer)",

      "Read(.pgpass)",
      "Read(**/.pgpass)",

      "Read(launchSettings.json)",
      "Read(**/launchSettings.json)",
      "Read(**/*.user)",

      "Read(**/*.bak)",
      "Read(**/*.dump)",

      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",

      "Bash(*appsettings*)",
      "Bash(*secrets.json*)",
      "Bash(*UserSecrets*)",
      "Bash(dotnet user-secrets*)",
      "Bash(*nuget.config*)",
      "Bash(*NuGet.Config*)",
      "Bash(*launchSettings*)",
      "Bash(*.pgpass*)",
      "Bash(*/.env*)",
      "Bash(* .env*)",
      "Bash(*.pfx*)",
      "Bash(*.p12*)",
      "Bash(*.pem*)",
      "Bash(*.key *)",
      "Bash(*.git-credentials*)",
      "Bash(*.netrc*)",
      "Bash(*.docker/config.json*)",
      "Bash(*.ssh/*)",
      "Bash(*.aws/*)",
      "Bash(*.kube/config*)",

      "Bash(cat *.env*)",
      "Bash(cat *appsettings*)",
      "Bash(cat *secrets.json*)",
      "Bash(cat *.pgpass*)",
      "Bash(type *.env*)",
      "Bash(type *appsettings*)",
      "Bash(Get-Content *.env*)",
      "Bash(Get-Content *appsettings*)",

      "Bash(git push)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)"
    ]
  }
}
